# RailSafe-AI Mobile Expo Environment Configuration
# Copy this file to .env or configure directly in app Settings page

# Python FastAPI Machine Learning Anomaly Detection Service URL
# - For Android Emulator: http://10.0.2.2:8000
# - For iOS Simulator: http://localhost:8000
# - For Physical Device running Expo Go on local Wi-Fi: http://<YOUR_COMPUTER_LOCAL_IP>:8000
EXPO_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8000

# RailGuard Vision / Railway Operations Cloud Backend URL
# - Default internal mock/demo URL: https://railguard-vision.internal
EXPO_PUBLIC_RAILGUARD_API_URL=https://railguard-vision.internal

# Enable or disable mock demo telemetry simulation when physical ESP32 BLE device is not connected
EXPO_PUBLIC_ENABLE_SIMULATION=true
